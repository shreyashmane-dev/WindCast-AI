# WindCast AI Git Ignore Rules

# Python Caches & Environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.env
.venv
venv/
ENV/
env/

# Large Machine Learning Models Binaries
# (Prevents GitHub push failures due to >100MB file size limits)
backend/trained_models/*.joblib
backend/trained_models/*.pkl
# Allow committing lightweight model files to ensure the application works out-of-the-box
!backend/trained_models/linear_regression.joblib
!backend/trained_models/lstm_scaler.joblib
!backend/trained_models/xgboost.joblib
!backend/trained_models/best_model.joblib
!backend/trained_models/best_model.pkl
backend/trained_models/random_forest.joblib
backend/trained_models/random_forest.pkl

/trained_models/
models/
model_legacy/

# Node.js / Next.js caches
node_modules/
.next/
out/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp*
.pnp.js

# Streamlit caches
.streamlit/

# OS/System files
.DS_Store
Thumbs.db

# Secrets & Credentials
*firebase-service-account.json
secret/
frontend/.env.local
backend/.env
backend/generated_reports/
